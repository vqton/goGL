{
  "name": "gogl-web",
  "private": true,
  "description": "TailwindCSS build for the goGL ERP front-end (Go html/templates).",
  "scripts": {
    "build:css": "tailwindcss -i ./web/css/input.css -o ./web/static/css/app.css --minify",
    "watch:css": "tailwindcss -i ./web/css/input.css -o ./web/static/css/app.css --watch",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/cli": "^4.1.0"
  }
}
